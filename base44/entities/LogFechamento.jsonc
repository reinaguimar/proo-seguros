{
  "name": "LogFechamento",
  "type": "object",
  "properties": {
    "fechamento_id": {
      "type": "string",
      "description": "ID do FechamentoMensal"
    },
    "acao": {
      "type": "string",
      "enum": [
        "criado",
        "calculado",
        "auditado",
        "enviado_mga",
        "aprovado_mga",
        "enviado_seguradora",
        "aprovado_seguradora",
        "fechado",
        "reaberto",
        "cancelado",
        "assinado_mga",
        "assinado_seguradora"
      ],
      "description": "Tipo de a\u00e7\u00e3o realizada"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou a a\u00e7\u00e3o"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o/justificativa da a\u00e7\u00e3o"
    },
    "ip_address": {
      "type": "string",
      "description": "IP de origem da a\u00e7\u00e3o"
    },
    "dados_snapshot": {
      "type": "object",
      "description": "Snapshot dos valores no momento da a\u00e7\u00e3o"
    },
    "assinatura_digital": {
      "type": "string",
      "description": "Hash SHA-256 da assinatura (se aplic\u00e1vel)"
    },
    "certificado_info": {
      "type": "object",
      "description": "Informa\u00e7\u00f5es do certificado digital usado (se aplic\u00e1vel)"
    },
    "versao_pdd": {
      "type": "number",
      "description": "Vers\u00e3o do PDD neste fechamento"
    }
  },
  "required": [
    "fechamento_id",
    "acao",
    "usuario_id"
  ]
}