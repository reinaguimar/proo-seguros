{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "filiais_permitidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das filiais que o usu\u00e1rio pode acessar. Array vazio = acesso irrestrito a todas as filiais (admin global)."
    },
    "filial_id_padrao": {
      "type": "string",
      "description": "ID da filial padr\u00e3o do usu\u00e1rio, usada como contexto inicial no dashboard e filtros. Deve estar contida em filiais_permitidas quando esse array n\u00e3o for vazio."
    },
    "ultimo_acesso": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do \u00faltimo login do usu\u00e1rio. Atualizado automaticamente pelo workflow Registrar \u00daltimo Acesso."
    }
  },
  "required": [
    "filial_id_padrao"
  ]
}