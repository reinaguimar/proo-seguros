{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "filiais_permitidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das filiais que o usuário pode acessar. Array vazio = acesso irrestrito a todas as filiais (admin global)."
    },
    "filial_id_padrao": {
      "type": "string",
      "description": "ID da filial padrão do usuário, usada como contexto inicial no dashboard e filtros. Deve estar contida em filiais_permitidas quando esse array não for vazio."
    }
  },
  "required": [
    "filial_id_padrao"
  ]
}