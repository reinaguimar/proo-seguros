{
  "name": "LogSinistro",
  "type": "object",
  "properties": {
    "sinistro_id": {
      "type": "string",
      "description": "ID do sinistro afetado"
    },
    "numero_sinistro": {
      "type": "string",
      "description": "N\u00famero do sinistro para busca"
    },
    "acao": {
      "type": "string",
      "enum": [
        "criado",
        "status_alterado",
        "dados_editados",
        "gasto_adicionado"
      ],
      "description": "Tipo de a\u00e7\u00e3o registrada"
    },
    "campo_alterado": {
      "type": "string",
      "description": "Campo que mudou (ex: status, valor_inicial, franquia)"
    },
    "valor_anterior": {
      "type": "string",
      "description": "Valor antes da altera\u00e7\u00e3o"
    },
    "valor_novo": {
      "type": "string",
      "description": "Valor ap\u00f3s a altera\u00e7\u00e3o"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que executou a a\u00e7\u00e3o"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio"
    },
    "data_acao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da a\u00e7\u00e3o"
    },
    "observacao": {
      "type": "string",
      "description": "Detalhe adicional da a\u00e7\u00e3o"
    }
  },
  "required": [
    "sinistro_id",
    "acao"
  ]
}