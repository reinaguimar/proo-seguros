{
  "name": "PDDVersao",
  "type": "object",
  "properties": {
    "competencia": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "pdd_competencia_id": {
      "type": "string",
      "description": "ID do PDDCompetencia"
    },
    "numero_versao": {
      "type": "number",
      "description": "N\u00famero sequencial da vers\u00e3o (1, 2, 3...)"
    },
    "total_inadimplentes": {
      "type": "number",
      "default": 0
    },
    "pdd_estimado": {
      "type": "number",
      "default": 0
    },
    "criterio": {
      "type": "string",
      "description": "Crit\u00e9rio de c\u00e1lculo usado"
    },
    "breakdown_por_faixa": {
      "type": "object",
      "description": "Detalhamento por faixa de aging"
    },
    "usuario_id": {
      "type": "string",
      "description": "Quem calculou esta vers\u00e3o"
    },
    "usuario_nome": {
      "type": "string"
    },
    "data_calculo": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi calculado"
    },
    "motivo_recalculo": {
      "type": "string",
      "description": "Por que foi recalculado (se houver)"
    },
    "parametros_id": {
      "type": "string",
      "description": "ID dos par\u00e2metros PDD usados"
    },
    "ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 a vers\u00e3o ativa do m\u00eas"
    },
    "data_ativacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi ativada"
    }
  },
  "required": [
    "competencia",
    "pdd_competencia_id",
    "numero_versao"
  ]
}