{
  "name": "LogDelecao",
  "type": "object",
  "properties": {
    "tipo_entidade": {
      "type": "string",
      "enum": [
        "Apolice",
        "Sinistro"
      ],
      "description": "Tipo de registro deletado"
    },
    "id_registro": {
      "type": "string",
      "description": "ID do registro deletado"
    },
    "id_registro_alternativo": {
      "type": "string",
      "description": "N\u00famero da ap\u00f3lice ou sinistro para refer\u00eancia"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que deletou"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que deletou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que deletou"
    },
    "motivo_delecao": {
      "type": "string",
      "description": "Motivo/justificativa da dele\u00e7\u00e3o"
    },
    "data_delecao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da dele\u00e7\u00e3o"
    },
    "ip_address": {
      "type": "string",
      "description": "IP da m\u00e1quina onde foi feita a dele\u00e7\u00e3o"
    },
    "dados_backup": {
      "type": "object",
      "description": "Snapshot dos dados antes da dele\u00e7\u00e3o"
    }
  },
  "required": [
    "tipo_entidade",
    "id_registro",
    "usuario_id",
    "motivo_delecao"
  ]
}