{
  "name": "GastoSinistro",
  "type": "object",
  "properties": {
    "id_sinistro": {
      "type": "string"
    },
    "numero_sinistro": {
      "type": "string"
    },
    "tipo_gasto": {
      "type": "string",
      "enum": [
        "oficina",
        "peca",
        "acordo_extrajudicial"
      ]
    },
    "nome_fornecedor": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "valor_total": {
      "type": "number"
    },
    "data_nota_fiscal": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "numero_nf": {
      "type": "string"
    },
    "numero_documento": {
      "type": "string"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "a_vista",
        "parcelado"
      ]
    },
    "numero_parcelas": {
      "type": "number"
    },
    "datas_pagamento": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "valores_parcelas": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pendente",
        "parcialmente_pago",
        "pago"
      ],
      "default": "pendente"
    },
    "anexos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs dos documentos anexados (NF, termos, recibos, etc.)"
    },
    "beneficiario_nome": {
      "type": "string",
      "description": "Nome do beneficiário do acordo extrajudicial"
    },
    "beneficiario_cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do beneficiário"
    },
    "banco_nome": {
      "type": "string",
      "description": "Nome do banco"
    },
    "banco_agencia": {
      "type": "string",
      "description": "Agência bancária"
    },
    "banco_conta": {
      "type": "string",
      "description": "Número da conta"
    },
    "banco_tipo_conta": {
      "type": "string",
      "enum": [
        "corrente",
        "poupanca",
        "pagamento"
      ],
      "description": "Tipo da conta bancária"
    },
    "banco_chave_pix": {
      "type": "string",
      "description": "Chave PIX do beneficiário"
    }
  },
  "required": [
    "id_sinistro",
    "tipo_gasto",
    "valor_total",
    "forma_pagamento"
  ]
}