{
  "name": "SequencialApolice",
  "type": "object",
  "properties": {
    "filial_id": {
      "type": "string",
      "description": "ID da filial dona deste contador"
    },
    "ano": {
      "type": "number",
      "description": "Ano de compet\u00eancia do contador"
    },
    "ultimo_sequencial": {
      "type": "number",
